APP_ENV=development
# Runtime profile: development (default stubs) | challenge (real stack defaults)
# LIMEN_RUNTIME_PROFILE=challenge
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CI / tests default (deterministic, no Ollama required):
LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=256
LLM_TIMEOUT_S=45
# Secondary LLM for non-critical experiments only — keep disabled.
LLM_SECONDARY_ENABLED=false
LLM_SECONDARY_MODEL=
# Safety fallback is always deterministic templates (not another model).
#
# Challenge runtime with selected G3 model (PHASE 5.1) — opt-in locally:
# LLM_PROVIDER=ollama
# LLM_MODEL=phi3.5
# LLM_BASE_URL=http://127.0.0.1:11434
# If Ollama is unreachable, LIMEN enters DEGRADED_LLM_MODE (Safety+RAG+templates).

STT_PROVIDER=stub
STT_MODEL=stub-stt
STT_API_KEY=
STT_DEVICE=auto
STT_MODEL_PATH=
STT_TIMEOUT_S=60
# Challenge STT (opt-in): STT_PROVIDER=faster_whisper
# STT_MODEL=Systran/faster-whisper-small
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16
# STT_ALLOW_CPU_FALLBACK=0
# Launch API with CUDA12 libs: make dev-api-voice

TTS_PROVIDER=stub
TTS_MODEL=stub-tts
TTS_VOICE=default
TTS_MODEL_PATH=
TTS_TIMEOUT_S=60
# Challenge TTS (opt-in): TTS_PROVIDER=piper
# TTS_VOICE=es_MX-claude-high
# TTS_MODEL_PATH=./runtime/models/piper
# Prepare assets: make prepare-voice
# Preflight: make verify-voice-environment

EMBEDDING_PROVIDER=stub
# Canonical HF id when EMBEDDING_MODEL_PATH is unset.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Optional local checkout/cache (takes precedence). Do not commit weights.
# EMBEDDING_MODEL_PATH=./runtime/models/multilingual-e5-small
EMBEDDING_DIMENSIONS=64
VECTOR_STORE_BACKEND=qdrant

# Official Tech Sphere dataset root (spreadsheets + textos/*.pdf).
# Resolution order if unset: LIMEN_DATASET_PATH → ./dataset/ → ./data/challenge/
# LIMEN_DATASET_PATH=/absolute/path/to/official/dataset

# Hybrid RRF knobs
DENSE_TOP_K=8
LEXICAL_TOP_K=8
FINAL_TOP_K=5
RRF_K=60
# Leave unset for provider-aware defaults (stub=0.35, e5≈0.795 calibrated).
# DENSE_MIN_SCORE=

DATABASE_PATH=./runtime/db/limen.db
VECTOR_PATH=./runtime/vectors
DOCUMENT_PATH=./runtime/documents
LOG_PATH=./runtime/logs
AUDIO_PATH=./runtime/audio

MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Conversation continuity (PHASE 6.3) — bounded recent window, not full transcript.
CONVERSATION_RECENT_TURNS=6
CONVERSATION_CONTEXT_TOKEN_BUDGET=1800

# Client accounts. The session cookie is always httpOnly; set
# AUTH_COOKIE_SECURE=true when serving over HTTPS.
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_NAME=limen_session
AUTH_COOKIE_SECURE=false

# Local demo login created by `make bootstrap` so a cold start can sign in
# immediately. Not a credential for any deployed environment — change it before
# exposing the API, or leave both values empty to create no account at all.
LIMEN_DEMO_EMAIL=demo@limen.local
LIMEN_DEMO_PASSWORD=limen-demo-2026
LIMEN_DEMO_NAME=LIMEN Demo
