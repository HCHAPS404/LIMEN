APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_API_KEY=
LLM_BASE_URL=

STT_PROVIDER=stub
STT_MODEL=stub-stt
STT_API_KEY=

TTS_PROVIDER=stub
TTS_MODEL=stub-tts
TTS_VOICE=default

EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=stub-embedding

DATABASE_PATH=./runtime/db/limen.db
VECTOR_PATH=./runtime/vectors
DOCUMENT_PATH=./runtime/documents
LOG_PATH=./runtime/logs
AUDIO_PATH=./runtime/audio

MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Client accounts. The session cookie is always httpOnly; set
# AUTH_COOKIE_SECURE=true when serving over HTTPS.
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_NAME=limen_session
AUTH_COOKIE_SECURE=false

# Local demo login created by `make bootstrap` so a cold start can sign in
# immediately. Not a credential for any deployed environment — change it before
# exposing the API, or leave both values empty to create no account at all.
LIMEN_DEMO_EMAIL=demo@limen.local
LIMEN_DEMO_PASSWORD=limen-demo-2026
LIMEN_DEMO_NAME=LIMEN Demo
